# ==============================================================================
# PORTAL NEWS - CONFIGURAÇÃO DE VARIÁVEIS DE AMBIENTE (.env.example)
# TODAS AS VARIÁVEIS E VALORES ESTÃO OCULTOS POR DIRETRIZ DE SEGURANÇA.
# Nunca compartilhe, versione ou exiba valores reais em repositórios ou código.
# Para produção, defina cada variável diretamente no painel do servidor.
# ==============================================================================

# 1. Google Gemini AI (Isolada exclusivamente no servidor, nunca exposta ao cliente)
GEMINI_API_KEY=""

# 2. URL da Aplicação e Domínio Base (Para Vercel: utilize preferencialmente APP_URL ou SITE_DOMAIN)
APP_URL=""
SITE_DOMAIN=""
NEXT_PUBLIC_SITE_URL=""

# 3. Google AdSense (Configurações de Blocos de Anúncio)
NEXT_PUBLIC_ADSENSE_ID=""
NEXT_PUBLIC_ADSENSE_SLOT_HEADER=""
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=""
NEXT_PUBLIC_ADSENSE_SLOT_FOOTER=""
GOOGLE_ADSENSE_CLIENT_ID=""
GOOGLE_ADSENSE_SLOT_HEADER=""
GOOGLE_ADSENSE_SLOT_SIDEBAR=""
GOOGLE_ADSENSE_SLOT_SIDEBAR_BOTTOM=""
GOOGLE_ADSENSE_SLOT_IN_ARTICLE=""
GOOGLE_ADSENSE_SLOT_FOOTER=""

# 4. News & Media Upstream API (Agregação de Notícias)
NEWS_API_BASE_URL=""
NEWS_API_FALLBACK_URL=""
NEWS_API_KEY=""

# 5. Previsão do Tempo (WeatherAPI)
WEATHER_API_KEY=""
WEATHER_API_BASE_URL=""
api_key_clima=""
api_url_clima_base=""

# 6. ElevenLabs Leitura em Áudio (Opcional - se vazio, utiliza síntese nativa Web Speech)
ELEVENLABS_API_KEY=""
ELEVENLABS_API_URL=""
ELEVENLABS_VOICE_ID=""

# 7. Resumo por IA Customizado (Opcional)
AI_SUMMARY_API_ENDPOINT=""
AI_SUMMARY_API_KEY=""
AI_SUMMARY_MODEL=""

# 8. Servidor SMTP (Google App Password / Formulário de Contato)
SMTP_HOST=""
SMTP_PORT=""
SMTP_SECURE=""
SMTP_USER=""
SMTP_PASS=""
CONTACT_RECEIVER_EMAIL=""

# ==============================================================================
# REGRAS DE SEGURANÇA E PROTEÇÃO DE DADOS:
# 1. Todas as variáveis sensíveis são mascaradas e protegidas contra visualização.
# 2. Nenhuma chave secreta, token ou credencial é prefixada com NEXT_PUBLIC_.
# 3. O código-fonte não possui valores hardcoded ou chaves de fallback expostas.
# 4. Sanitização recursiva em endpoints de API para impedir vazamento acidental.
# ==============================================================================
